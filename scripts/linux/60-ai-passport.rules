# AI Passport (ESP32-C3 USB-JTAG/Serial, 303a:1001): let the logged-in user open the
# serial port without joining the dialout group, and keep ModemManager from probing it
# (its AT commands can disturb the download-mode handshake).
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", ENV{ID_MM_DEVICE_IGNORE}="1"
